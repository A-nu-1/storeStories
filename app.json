{
  "expo": {
    "name": "StoriesWithAnu",
    "slug": "storeStories",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appimg.png",
    "scheme": "storestories",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/appimg.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "backgroundImage": "./assets/appimg.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.storeStories"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/appimg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49be9b22-1314-4b29-b125-6810bfaeca08"
      }
    },
    "owner": "anupama1"
  }
}
